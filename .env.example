# AI PDF Assistant — Environment Configuration Template
# Copy this file to .env in your backend environment

# ==============================================================================
# Environment & Application Settings
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI PDF Assistant API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Database Configuration (PostgreSQL + pgvector)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pdf_assist_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pdf_assist_db

# ==============================================================================
# Storage Configuration (Local or S3-compatible: MinIO / AWS S3)
# ==============================================================================
STORAGE_BACKEND=supabase
# Options: "local", "s3", or "supabase"
LOCAL_STORAGE_PATH="./data/storage"

# Supabase Storage Settings (used if STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME="files assist"

# S3 / MinIO Settings (used if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=pdf-assist-documents
S3_REGION=us-east-1

# ==============================================================================
# AI & Vector Settings (OpenAI / Azure OpenAI / Local)
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG Hyperparameters
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.65

# ==============================================================================
# Background Processing & Task Queue
# ==============================================================================
BACKGROUND_MODE=in_process
# Options: "in_process" (FastAPI BackgroundTasks) or "celery"
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Document Limits & Guardrails
# ==============================================================================
MAX_UPLOAD_SIZE_MB=25
MAX_PAGE_COUNT=250
SUPPORTED_MIME_TYPES=["application/pdf"]
